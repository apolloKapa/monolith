#!/bin/sh
# Roblox Studio's MCP server (StudioMCP.exe), run in the same Wine as Studio so they can
# talk: Studio in Bottles (its "RobloxStudio" bottle, while Bottles is running) or else
# Studio in Vinegar.

# --- Bottles: step into the running Bottles sandbox (Studio's Wine server is only there)
BOT="$HOME/.var/app/com.usebottles.bottles/data/bottles"
INST=$(flatpak ps --columns=instance,application 2>/dev/null | awk '$2=="com.usebottles.bottles"{print $1; exit}')
if [ -n "$INST" ] && [ -d "$BOT/bottles/RobloxStudio" ]; then
	PREFIX="$BOT/bottles/RobloxStudio"
	WINE=$(ls -td "$BOT"/runners/*/bin/wine 2>/dev/null | head -n1)
	EXE=$(ls -td "$PREFIX"/drive_c/users/"$USER"/AppData/Local/Roblox/Versions/version-*/StudioMCP.exe 2>/dev/null | head -n1)
	[ -z "$EXE" ] && EXE=$(ls -td "$PREFIX"/drive_c/users/*/AppData/Local/Roblox/Versions/version-*/StudioMCP.exe 2>/dev/null | head -n1)
	if [ -n "$WINE" ] && [ -n "$EXE" ]; then
		exec flatpak enter "$INST" env WINEPREFIX="$PREFIX" WINEDEBUG=-all "$WINE" "$EXE" "$@"
	fi
fi

# --- Vinegar
V="$HOME/.var/app/org.vinegarhq.Vinegar/data/vinegar"
WINE=$(find "$V" -path '*/bin/wine' \( -type f -o -type l \) 2>/dev/null | head -n1)
EXE=$(ls -td "$V"/versions/version-*/StudioMCP.exe 2>/dev/null | head -n1)
[ -z "$WINE" ] && { echo "Vinegar's wine not found under $V (and no running Bottles Studio)" >&2; exit 1; }
exec flatpak run --command="$WINE" --env=WINEPREFIX="$V/prefixes/studio" org.vinegarhq.Vinegar "$EXE" "$@"
