prefer-no-csd

// ===================== Input =====================
// Keyboard layout, touchpad/mouse behavior, and focus-follows-mouse.
input {
    focus-follows-mouse
    keyboard {
        xkb {
            layout "us,gr"
            options "grp:alt_shift_toggle"
        }
        numlock
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}   

// ===================== Cursor =====================
// Active cursor theme and size (used across all apps that respect XCURSOR settings).
cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 22
}

// ===================== Environment =====================
// Environment variables set for every process niri launches.
// QT_QPA_PLATFORMTHEME tells Qt apps (Dolphin, qt6ct-aware apps) to use qt6ct's theme config.
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    XDG_CURRENT_DESKTOP "Niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "Niri"
}

// ===================== Outputs =====================
// Monitor layout: resolution, refresh rate, position on the virtual desktop, rotation, scale.
output "DP-1" {
    mode "2560x1440@239.970"
    position x=0 y=0
    scale 1
}

output "DP-2" {
    mode "1920x1080@239.760"
    position x=320 y=-1080
    scale 1
    transform "180"
}

output "HDMI-A-1" {
    off
}

// ===================== Autostart =====================
// Programs launched automatically once niri starts.
// steam = game launcher, silent boot. (openrgb now autostarts via its own "Start with system" setting)
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-at-startup "sh" "-c" "sleep 8 && steam -silent"
spawn-at-startup "bash" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch cliphist store"
spawn-at-startup "awww-daemon"
spawn-at-startup "setwall"

// ===================== Workspaces =====================
// Named, static workspaces 1-10. Unlike niri's default dynamic workspaces (which appear/disappear
// as needed), these always exist and never collapse when empty.
workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"
workspace "10"
workspace "d2-1" { open-on-output "DP-2"; }
workspace "d2-2" { open-on-output "DP-2"; }
workspace "d2-3" { open-on-output "DP-2"; }
workspace "d2-4" { open-on-output "DP-2"; }
workspace "d2-5" { open-on-output "DP-2"; }
workspace "d2-6" { open-on-output "DP-2"; }
workspace "d2-7" { open-on-output "DP-2"; }
workspace "d2-8" { open-on-output "DP-2"; }
workspace "d2-9" { open-on-output "DP-2"; }
workspace "d2-10" { open-on-output "DP-2"; }

// ===================== Layout =====================
gestures {
    hot-corners {
        off
    }
}

layout {
    gaps 10

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 2
        active-color "#ffffff"
        inactive-color "#555555"
        urgent-color "#9b0000"
    }
}

// ===================== Hotkey Overlay =====================
hotkey-overlay {
    skip-at-startup
}

// ===================== Screenshots =====================
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ===================== Animations =====================
animations {
    slowdown 0.6
    workspace-switch { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    window-movement { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    window-resize { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    overview-open-close { spring damping-ratio=1.0 stiffness=800 epsilon=0.0001; }
    window-open { duration-ms 180; curve "ease-out-expo"; }
    window-close { duration-ms 140; curve "ease-out-quad"; }
    config-notification-open-close { spring damping-ratio=0.6 stiffness=1000 epsilon=0.001; }
    screenshot-ui-open { duration-ms 200; curve "ease-out-quad"; }
    exit-confirmation-open-close { spring damping-ratio=0.6 stiffness=500 epsilon=0.01; }
}

// ===================== Window Rules =====================


// ===================== Keybinds =====================
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+C hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+B { spawn "librewolf"; }
    Mod+E { spawn "thunar"; }
    Mod+Escape { spawn "missioncenter"; }

    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Ctrl+Z repeat=false { spawn-sh "pgrep -x wooz > /dev/null || wooz --mouse-track"; }


    Mod+Q repeat=false { close-window; }

    Mod+Left { spawn "focuswin" "left"; }
    Mod+Ctrl+Left { spawn "snap" "left"; }
    Mod+Down { spawn "focuswin" "down"; }
    Mod+Ctrl+Down { spawn "snap" "down"; }
    Mod+Up { spawn "focuswin" "up"; }
    Mod+Ctrl+Up { spawn "snap" "up"; }
    Mod+Right { spawn "focuswin" "right"; }
    Mod+Ctrl+Right { spawn "snap" "right"; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L { spawn "monolith" "lock"; }

    Mod+Shift+Left  { spawn "swapwin" "left"; }
    Mod+Shift+Down  { spawn "swapwin" "down"; }
    Mod+Shift+Up    { spawn "swapwin" "up"; }
    Mod+Shift+Right { spawn "swapwin" "right"; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+Down  { focus-monitor-down; }
    Mod+Alt+Up    { focus-monitor-up; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+D { spawn "monolith" "msg" "toggle" "system"; }
    Mod+S { spawn "monolith" "msg" "toggle" "guide"; }
    Mod+N { spawn "monolith" "msg" "toggle" "network"; }
    Mod+V { spawn "monolith" "msg" "toggle" "volume"; }
    Mod+A { spawn "monolith" "msg" "toggle" "autohide"; }
    Mod+Alt+C { spawn "monolith" "msg" "toggle" "clipboard"; }
    Mod+Alt+M { spawn "monolith" "msg" "toggle" "music"; }
    Mod+Alt+W { spawn "monolith" "msg" "toggle" "wallpaper"; }
    Mod+Alt+H { spawn "monolith" "msg" "toggle" "guide"; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R repeat=false { spawn "tilehalf"; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; }
    Mod+T { spawn-sh "niri msg -j focused-window | jq -e .is_floating >/dev/null && niri msg action toggle-window-floating; niri msg action maximize-column"; }

    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+M repeat=false { quit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Launcher (rofi)
    Mod+Z { spawn "monolith" "msg" "toggle" "launcher"; }
    Mod+Space { spawn "monolith" "msg" "toggle" "launcher"; }
    Mod+Tab { spawn "rofi" "-show" "window" "-hover-select" "-me-select-entry" "" "-me-accept-entry" "MousePrimary"; }
    Mod+Alt+S { spawn "setwall" "pick"; }
    Mod+Alt+V { spawn-sh "cliphist list | rofi -dmenu | cliphist decode | wl-copy"; }

    // Media keys, brightness, screenshots, lock
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "5%+"; }
    Print { screenshot; }
    Mod+Shift+S { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Mod+Ctrl+Alt+L { spawn "swaylock"; }
    Mod+Alt+L { spawn "monolith" "lock"; }
}


window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Every window opens floating (DE style): Mod+left-drag moves, Mod+right-drag resizes.
window-rule {
    open-floating true
}

// Roblox Studio (in Wine) makes three tiny hidden helper windows titled just
// "RobloxStudio": on Windows you never see them; here they'd open as black windows.
// Kept small, floating, invisible and out of the way (the real Studio window's title
// has the place name in it, so it isn't matched).
window-rule {
    match title="^RobloxStudio$"
    open-maximized false
    open-floating true
    open-focused false
    opacity 0.0
    default-column-width { fixed 1; }
    default-window-height { fixed 1; }
    // (no frame round them either, or the frame shows as a dot)
    focus-ring { off; }
    border { off; }
    shadow { off; }
    geometry-corner-radius 0
    default-floating-position x=0 y=0 relative-to="bottom-right"
}


// Steam's friend/game toasts ("X is playing ...") are real windows (titled notificationtoasts_N_desktop).
// Make them behave like notifications: top-right where mako puts its popups, never take focus,
// no frame of their own.
window-rule {
    match title="^notificationtoasts_"
    open-floating true
    open-focused false
    default-floating-position x=0 y=0 relative-to="top-right"
    border { off; }
    focus-ring { off; }
    shadow { off; }
}

// ===== Monolith shell =====
spawn-at-startup "systemctl" "--user" "enable" "--now" "easyeffects"
spawn-at-startup "monolithd" "start"

// Terminal default size
window-rule {
    match app-id="kitty"
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}
