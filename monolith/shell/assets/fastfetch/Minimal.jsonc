// Minimal: no logo, a short list with the labels in your accent colour
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": { "type": "none" },
  "display": {
    "separator": "  ",
    "key": { "width": 9 },
    "color": { "keys": "{{primary}}", "output": "{{on_surface}}" }
  },
  "modules": [
    { "type": "title", "color": { "user": "{{primary}}", "at": "{{outline}}", "host": "{{tertiary}}" } },
    "break",
    { "type": "os", "key": "os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "shell", "format": "{pretty-name}" },
    { "type": "uptime", "key": "uptime" },
    { "type": "memory", "key": "memory" }
  ]
}
