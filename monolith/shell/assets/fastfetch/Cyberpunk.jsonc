// Cyberpunk: a glitched MONOLITH banner and a HUD readout in neon yellow, cyan and red (its own colours, whatever the theme)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1███╗   ███╗ ██████╗ ███╗   ██╗ ██████╗ ██╗     ██╗████████╗██╗  ██╗\n$3  ████╗ ████║██╔═══██╗████╗  ██║██╔═══██╗██║     ██║╚══██╔══╝██║  ██║\n$1██╔████╔██║██║   ██║██╔██╗ ██║██║   ██║██║     ██║   ██║   ███████║\n$2 ██║╚██╔╝██║██║   ██║██║╚██╗██║██║   ██║██║     ██║   ██║   ██╔══██║\n$1██║ ╚═╝ ██║╚██████╔╝██║ ╚████║╚██████╔╝███████╗██║   ██║   ██║  ██║\n$1╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚══════╝╚═╝   ╚═╝   ╚═╝  ╚═╝\n$3▀▀▀▀▀▀ ▀▀▀  ▀▀▀▀▀▀▀▀▀▀▀ ▀  ▀▀▀▀ ▀▀▀▀▀▀▀▀▀ ▀▀  ▀▀▀▀▀▀▀▀▀▀▀▀▀ ▀▀▀▀▀▀",
    "position": "top",
    "color": {
      "1": "#fcee0a",
      "2": "#00f0ff",
      "3": "#ff2a6d"
    },
    "padding": {
      "top": 1,
      "left": 0,
      "right": 0
    }
  },
  "display": {
    "separator": "",
    "constants": [
      "\u001b[38;2;252;238;10m",
      "\u001b[38;2;0;240;255m",
      "\u001b[38;2;255;42;109m",
      "\u001b[38;2;85;85;122m",
      "\u001b[38;2;230;251;255m",
      "\u001b[0m",
      "\u001b[48;2;252;238;10m\u001b[38;2;10;10;15m\u001b[1m",
      "\u001b[48;2;255;42;109m\u001b[38;2;10;10;15m\u001b[1m"
    ],
    "color": {
      "keys": "default",
      "output": "default"
    }
  },
  "modules": [
    {
      "type": "command",
      "text": "echo \"$USER@$(cat /etc/hostname 2>/dev/null || hostname)\"",
      "key": "{$7} SYS//DIAG {$6}{$1}▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰ {$6}\n{$3}▸ {$2}RUNNER   {$4}//{$6} ",
      "format": "{$5}{}{$6}"
    },
    {
      "type": "os",
      "key": "{$2}▸ {$2}OS       {$4}//{$6} ",
      "format": "{$5}{pretty-name}{$6}"
    },
    {
      "type": "kernel",
      "key": "{$2}▸ {$2}KERNEL   {$4}//{$6} ",
      "format": "{$5}{release}{$6}"
    },
    {
      "type": "wm",
      "key": "{$2}▸ {$2}WM       {$4}//{$6} ",
      "format": "{$5}{pretty-name}{$6}"
    },
    {
      "type": "shell",
      "key": "{$2}▸ {$2}SHELL    {$4}//{$6} ",
      "format": "{$5}{pretty-name}{$6}"
    },
    {
      "type": "command",
      "text": "echo \"Monolith $(cat ~/.local/share/monolith/version.txt 2>/dev/null)\"",
      "key": "{$2}▸ {$2}DECK     {$4}//{$6} ",
      "format": "{$5}{}{$6}"
    },
    {
      "type": "command",
      "text": "uptime -p | cut -d ' ' -f 2-",
      "key": "{$2}▸ {$2}UPTIME   {$4}//{$6} ",
      "format": "{$5}{}{$6}"
    },
    {
      "type": "custom",
      "format": "{$7} CHROME {$6}{$1}▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰▰ {$6}"
    },
    {
      "type": "cpu",
      "key": "{$3}▸ {$2}CPU      {$4}//{$6} ",
      "format": "{$5}{name}{$6}"
    },
    {
      "type": "gpu",
      "hideType": "integrated",
      "key": "{$3}▸ {$2}GPU      {$4}//{$6} ",
      "format": "{$5}{name}{$6}"
    },
    {
      "type": "command",
      "text": "eval $(free -b | awk 'NR==2{print \"U=\"$3\" T=\"$2}'); awk -v u=\"$U\" -v t=\"$T\" 'BEGIN{n=20; f=int(u/t*n+0.5); s=\"\"; for(i=0;i<n;i++) s=s (i<f?\"▰\":\"▱\"); printf \"%s %3d%%  \", s, u/t*100}'; free -b | awk 'NR==2{printf \"%.1f / %.1f GiB\",$3/1073741824,$2/1073741824}'",
      "key": "{$3}▸ {$2}RAM      {$4}//{$6} ",
      "format": "{$1}{}{$6}"
    },
    {
      "type": "command",
      "text": "eval $(df -B1 / | awk 'NR==2{print \"U=\"$3\" T=\"$2}'); awk -v u=\"$U\" -v t=\"$T\" 'BEGIN{n=20; f=int(u/t*n+0.5); s=\"\"; for(i=0;i<n;i++) s=s (i<f?\"▰\":\"▱\"); printf \"%s %3d%%  \", s, u/t*100}'; df -h / | awk 'NR==2{print $3\" / \"$2}'",
      "key": "{$3}▸ {$2}DISK     {$4}//{$6} ",
      "format": "{$1}{}{$6}"
    },
    {
      "type": "packages",
      "key": "{$3}▸ {$2}PKGS     {$4}//{$6} ",
      "format": "{$5}{all}{$6}"
    },
    {
      "type": "custom",
      "format": "{$8} LINK ESTABLISHED {$6} {$3}░▒▓{$1}█████{$2}█████{$3}█████{$2}▓▒░ {$4}ICE: nominal // trace: none{$6}"
    }
  ]
}
