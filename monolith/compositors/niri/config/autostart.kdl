// Autostart
// Part of Monolith's niri setup (included from ../config.kdl).
// Only what Monolith needs: add your own apps below, e.g.
//   spawn-at-startup "steam" "-silent"

// clipboard history (Monolith's clipboard panel reads it)
spawn-at-startup "bash" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch cliphist store"

// the shell
// by full path, with ~/.local/bin on PATH for everything it starts: on a fresh PC niri's PATH
// may not have it yet, and a bare "monolithd" left the plain grey niri screen
spawn-at-startup "bash" "-c" "export PATH=\"$HOME/.local/bin:$PATH\"; exec \"$HOME/.local/bin/monolithd\" start"
