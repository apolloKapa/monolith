// Input: keyboard layouts, mouse, focus
// Part of Monolith's niri setup (included from ../config.kdl).

// ===================== Input =====================
// Keyboard layout, touchpad/mouse behavior, and focus-follows-mouse.
input {
    // focus whatever window the mouse moves into, scrolling the view (up to one screen) when
    // it's only partly visible; without the limit only fully visible windows got focused, so a
    // wide column hanging off the right edge never did
    focus-follows-mouse max-scroll-amount="100%"
    keyboard {
        xkb {
            layout "us,gr"
            options "grp:alt_shift_toggle"
        }
        numlock
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
}   

// ===================== Cursor =====================
// Active cursor theme and size (used across all apps that respect XCURSOR settings).
cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 22
}
