// Window rules
// Part of Monolith's niri setup (included from ../config.kdl).

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Monolith Settings opens floating: its liquid glass draws the wallpaper behind it, and
// niri only reports where floating windows are (tiled and fullscreen spots are worked out
// from the tile sizes and what the bar/frame/dock reserve, drags from the mouse's motion).
// When none of that works (a column scrolled to an unknown spot, no access to the mouse)
// the glass steps aside and this backdrop (the real wallpaper, blurred) shows instead.
window-rule {
    match app-id="^monolith-settings$"
    open-floating true
    background-effect {
        blur true
        xray true
    }
}

// Steam's friend/game toasts ("X is playing ...") are real windows (titled notificationtoasts_N_desktop).
// Make them behave like notifications: top-right where mako puts its popups, never take focus,
// no frame of their own.
window-rule {
    match title="^notificationtoasts_"
    open-floating true
    open-focused false
    default-floating-position x=0 y=0 relative-to="top-right"
    border { off; }
    focus-ring { off; }
    shadow { off; }
}

