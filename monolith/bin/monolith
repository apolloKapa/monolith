#!/bin/sh
# Monolith's command line.
#   monolith start [--login] | restart | stop     the shell (--login: also the startup apps)
#   monolith msg toggle|open <page>               what the keybinds call
#   monolith hub <page> | search <text> | settings <section> | appimages | lock
#   monolith screenshot [--full] [--edit]
#   monolith zoom in | out
#   monolith timer <minutes> | record [region]
#   monolith set <setting> <json> | get <setting>
#   monolith installer [--update]                 update Monolith, or change the install's choices
#   monolith migrate                              point an older niri config at this shell
here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
qml="$here/shell/shell.qml"
niri_conf="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
shots="$HOME/Pictures/Screenshots"

ipc() { quickshell ipc -p "$qml" call "$@"; }
running() { pgrep -f "quickshell -p $qml" >/dev/null; }
start() { running || niri msg action spawn -- quickshell -p "$qml"; }
# any copy of the shell (an installed one, a checkout)
stop() { pkill -f 'quickshell -p [^ ]*/shell/shell\.qml' 2>/dev/null; }

# page names the keybinds use → hub pages
page_for() {
    case "$1" in
        launcher) echo search ;;  system|dashboard) echo quick ;;  volume|audio) echo sound ;;
        music|media) echo media ;;  cheatsheet) echo keys ;;  switcher|overview) echo windows ;;
        calendar|clock) echo calendar ;;  notifications|notifs) echo notifications ;;
        *) echo "$1" ;;
    esac
}

# older configs started the shell with monolithd, zoomed with a script of the old shell, or
# called the trial command (monolith-next); this moves those lines over. Nothing else changes.
migrate() {
    for f in "$niri_conf"/config.kdl "$niri_conf"/config/*.kdl; do
        [ -f "$f" ] || continue
        sed -i \
            -e 's|"bash" "-c" "\$HOME/.local/share/monolith/src/scripts/zoom.sh \([a-z]*\)"|"'"$HOME"'/.local/bin/monolith" "zoom" "\1"|' \
            -e 's|"[^"]*/bin/monolith-next" "zoom|"'"$HOME"'/.local/bin/monolith" "zoom|' \
            -e 's|"[^"]*/bin/monolith-next"|"'"$HOME"'/.local/bin/monolith"|g' \
            -e 's|^\([[:space:]]*\)spawn-at-startup .*monolithd.* start".*$|\1spawn-at-startup "'"$HOME"'/.local/bin/monolith" "start" "--login"|' \
            -e 's|^// (monolith-next) spawn-at-startup .*$||' \
            -e '/the new shell (monolith-next back undoes this)/d' \
            "$f"
    done
    # the trial left two login lines; keep one
    f="$niri_conf/config/autostart.kdl"
    [ -f "$f" ] && awk '!(/spawn-at-startup ".*\/monolith" "start" "--login"/ && seen++)' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    return 0
}

case "$1" in
    start)
        start
        [ "$2" = "--login" ] && (sleep 2; python3 "$here/shell/scripts/startup.py" run) &
        ;;
    stop) stop ;;
    restart|reload) stop; sleep 0.3; start ;;
    msg)
        name="$3"
        case "$name" in
            emoji) ipc hub search ":" ;;
            autohide) ipc status toggle ;;
            appimages|autostart) ipc settings open software ;;
            *) ipc hub "${2:-toggle}" "$(page_for "$name")" ;;
        esac
        ;;
    hub) ipc hub toggle "$(page_for "${2:-search}")" ;;
    search) ipc hub search "$2" ;;
    settings) ipc settings open "${2:-appearance}" ;;
    appimages) ipc settings open software ;;
    lock) ipc lock lock ;;
    screenshot)
        full=0; edit=0
        for a in "$@"; do case "$a" in --full) full=1 ;; --edit) edit=1 ;; esac; done
        if [ $edit = 1 ]; then
            mkdir -p "$shots"
            f="$shots/Screenshot_$(date +%Y%m%d_%H%M%S).png"
            if [ $full = 1 ]; then grim "$f"; else g=$(slurp) || exit 0; grim -g "$g" "$f"; fi
            exec satty --filename "$f" --output-filename "$f"
        fi
        [ $full = 1 ] && exec niri msg action screenshot-screen
        exec niri msg action screenshot
        ;;
    zoom)
        # wooz: a zoomable picture of the screen. The first step opens it (scroll in it to zoom,
        # Esc or zooming out closes it).
        case "$2" in
            out|off) pkill -x wooz ;;
            *) pgrep -x wooz >/dev/null || exec wooz ;;
        esac
        ;;
    timer) ipc tasks timer "${2:-0}" ;;
    record) ipc tasks record "$([ "$2" = region ] && echo true || echo false)" ;;
    set) ipc store set "$2" "$3" ;;
    get) ipc store get "$2" ;;
    installer)
        shift
        # the copy installed with Monolith, else this checkout's
        for i in "$HOME/.local/share/monolith/install/install.sh" "$here/../install/install.sh"; do
            [ -f "$i" ] && exec bash "$i" "$@"
        done
        echo "No installer found." >&2; exit 1
        ;;
    migrate) migrate ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
