+/// The screen edge zone a point is in (logical, within the output): the left or right half, a
+/// quarter at a corner (the outer quarter of an edge), the top (the whole screen), or none.
+fn edge_zone(pos: Point<f64, Logical>, size: Size<f64, Logical>) -> Option<&'static str> {
+    let e = 2.;
+    let (l, r) = (pos.x <= e && pos.x >= 0., pos.x >= size.w - 1. - e);
+    let (t, b) = (pos.y <= e && pos.y >= 0., pos.y >= size.h - 1. - e);
+    let (qx, qy) = (size.w * 0.25, size.h * 0.25);
+    if l {
+        return Some(if pos.y < qy {
+            "top-left"
+        } else if pos.y > size.h - qy {
+            "bottom-left"
+        } else {
+            "left"
+        });
+    }
+    if r {
+        return Some(if pos.y < qy {
+            "top-right"
+        } else if pos.y > size.h - qy {
+            "bottom-right"
+        } else {
+            "right"
+        });
+    }
+    if t {
+        return Some(if pos.x < qx {
+            "top-left"
+        } else if pos.x > size.w - qx {
+            "top-right"
+        } else {
+            "top"
+        });
+    }
+    if b {
+        if pos.x < qx {
+            return Some("bottom-left");
+        }
+        if pos.x > size.w - qx {
+            return Some("bottom-right");
+        }
+    }
+    None
+}
