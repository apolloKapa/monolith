+/// The shrink and grow-back's own smooth easing, in real time: the animation slowdown setting
+/// (and a stiff window-movement spring) made it a jump (Monolith's patch).
+pub(crate) fn drag_scale_anim(clock: &Clock, from: f64, to: f64, real_ms: f64) -> Animation {
+    let ms = (real_ms * clock.rate()).round().max(1.) as u64;
+    Animation::ease(clock.clone(), from, to, 0., ms, crate::animation::Curve::EaseOutCubic)
+}
 
