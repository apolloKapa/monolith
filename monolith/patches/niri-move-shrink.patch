+    /// Growing back from `from_scale` around `origin` (within the window), as a window let go
+    /// after being dragged shrunk does (Monolith's patch). The open animation's offscreen, without
+    /// its fade or shader.
+    pub fn start_drop_animation(&mut self, from_scale: f64, origin: Point<f64, Logical>) {
+        self.open_animation = Some(OpenAnimation::new_drop(
+            super::drag_scale_anim(&self.clock, 0., 1., 220.),
+            from_scale,
+            origin,
+        ));
+    }
+
     pub fn resize_animation(&self) -> Option<&Animation> {
         self.resize_animation.as_ref().map(|resize| &resize.anim)
     }
