+    fn set_window_state(&mut self, window: x::Window, fullscreen: bool, maximized: bool) {
+        let mut data = Vec::new();
+        if fullscreen {
+            data.push(self.atoms.wm_fullscreen);
+        }
+        if maximized {
+            data.push(self.atoms.wm_max_vert);
+            data.push(self.atoms.wm_max_horz);
+        }
+        if let Err(e) = self
+            .connection
+            .send_and_check_request(&x::ChangeProperty::<x::Atom> {
+                mode: x::PropMode::Replace,
+                window,
+                property: self.atoms.net_wm_state,
+                r#type: x::ATOM_ATOM,
+                data: &data,
+            })
+        {
+            warn!("Failed to set the state of {window:?} ({e})");
+        }
+    }
