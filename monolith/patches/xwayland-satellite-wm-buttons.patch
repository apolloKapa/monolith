+    // (Monolith's patch: an app's own maximise and minimise buttons, passed on to the compositor)
+    fn toplevel_of(&self, window: x::Window) -> Option<XdgToplevel> {
+        let data = self
+            .windows
+            .get(&window)
+            .copied()
+            .and_then(|id| self.world.entity(id).ok())?;
+        let role = data.get::<&SurfaceRole>()?;
+        let SurfaceRole::Toplevel(Some(toplevel)) = &*role else {
+            return None;
+        };
+        Some(toplevel.toplevel.clone())
+    }
+
+    fn is_maximized(&self, window: x::Window) -> bool {
+        let Some(data) = self
+            .windows
+            .get(&window)
+            .copied()
+            .and_then(|id| self.world.entity(id).ok())
+        else {
+            return false;
+        };
+        let Some(role) = data.get::<&SurfaceRole>() else {
+            return false;
+        };
+        matches!(&*role, SurfaceRole::Toplevel(Some(t)) if t.maximized)
+    }
+
+    pub fn set_maximized(&mut self, window: x::Window, state: super::xstate::SetState) {
+        let Some(toplevel) = self.toplevel_of(window) else {
+            warn!("Tried to maximize an unknown or unmapped window {window:?}");
+            return;
+        };
+        use crate::xstate::SetState;
+        let want = match state {
+            SetState::Add => true,
+            SetState::Remove => false,
+            SetState::Toggle => !self.is_maximized(window),
+        };
+        if want {
+            toplevel.set_maximized();
+        } else {
+            toplevel.unset_maximized();
+        }
+    }
+
+    pub fn minimize_window(&mut self, window: x::Window) {
+        let Some(toplevel) = self.toplevel_of(window) else {
+            warn!("Tried to minimize an unknown or unmapped window {window:?}");
+            return;
+        };
+        toplevel.set_minimized();
+    }
+
