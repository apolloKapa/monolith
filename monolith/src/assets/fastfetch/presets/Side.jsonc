// Side: a small distro logo, icons for every line and coloured blocks under it
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "right": 4 },
    "color": { "1": "{{primary}}", "2": "{{secondary}}" }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{tertiary}}", "output": "{{on_surface}}" }
  },
  "modules": [
    { "type": "title", "key": "\uf007", "color": { "user": "{{primary}}", "host": "{{secondary}}" } },
    { "type": "os", "key": "", "format": "{pretty-name}" },
    { "type": "kernel", "key": "" },
    { "type": "wm", "key": "", "format": "{pretty-name}" },
    { "type": "terminal", "key": "" },
    { "type": "cpu", "key": "", "format": "{name}" },
    { "type": "memory", "key": "󰍛" },
    { "type": "uptime", "key": "󰅐" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
